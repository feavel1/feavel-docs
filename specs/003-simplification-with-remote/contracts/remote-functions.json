			"ChatMessage": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"conversation_id": {
						"type": "string"
					},
					"message": {
						"type": "string"
					},
					"sent_from": {
						"type": "string"
					},
					"created_at": {
						"type": "string",
						"format": "date-time"
					},
					"updated_at": {
						"type": "string",
						"format": "date-time"
					}
